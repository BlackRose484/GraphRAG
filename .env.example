# ── LLM (LiteLLM format: <provider>/<model>) ─────────────────────────────────
# Uncomment the provider block you want to use.

# --- Google Gemini (default) ---
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-2.0-flash
LLM_EMBEDDING_MODEL=gemini/text-embedding-004

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
# LLM_EMBEDDING_MODEL=gemini/text-embedding-004

# --- OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=openai/gpt-4o
# LLM_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Local Ollama (no API key needed) ---
# LLM_MODEL=ollama/llama3.2
# LLM_EMBEDDING_MODEL=ollama/nomic-embed-text

# ── LLM tuning ────────────────────────────────────────────────────────────────
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0
LLM_TEMPERATURE=0.7

# ── Multi-model allowlist (for benchmark UI dropdown) ─────────────────────────
# Comma-separated list of models that the Benchmark page offers in its LLM
# selector. LLM_MODEL above is always included and picked as default. Models
# whose API key is not set are automatically filtered out of the dropdown,
# so it's safe to list models for every provider you might use.
# LLM_MODELS_AVAILABLE=openai/gpt-5-mini,anthropic/claude-3-5-haiku-20241022,gemini/gemini-2.0-flash,ollama/llama3.2

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── ChromaDB (optional — not used in main pipeline) ───────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Set to 'false' to disable writing to logs/ directory
LOG_TO_FILE=true
# Set to 'false' to suppress console output
LOG_TO_STDOUT=true
