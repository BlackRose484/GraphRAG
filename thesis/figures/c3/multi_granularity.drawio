<mxfile host="app.diagrams.net" agent="Claude" version="22.0.0" type="device">
  <diagram name="Multi-Granularity" id="multi-granularity">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ĐẦU VÀO -->
        <mxCell id="input" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;Tập thực thể đã trích xuất E&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;{characters, actors, plays, scenes}&lt;/font&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=16;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="400" height="90" as="geometry"/>
        </mxCell>

        <!-- ① Node -->
        <mxCell id="node_lv" value="&lt;b style=&quot;font-size:18px&quot;&gt;① Node&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Mô tả truy xuất&lt;/b&gt;&lt;br&gt;Tìm thực thể theo tên hiển thị&lt;br&gt;trong các nhãn ontology&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;Thuộc tính thực thể&lt;br&gt;&lt;br&gt;&lt;b&gt;Vai trò&lt;/b&gt;&lt;br&gt;Định danh, mô tả cơ bản"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;align=center;verticalAlign=top;spacingTop=10;"
                vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="280" height="280" as="geometry"/>
        </mxCell>

        <!-- ② Triplet -->
        <mxCell id="triplet_lv" value="&lt;b style=&quot;font-size:18px&quot;&gt;② Triplet&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Mô tả truy xuất&lt;/b&gt;&lt;br&gt;Trích các bộ ba quan hệ&lt;br&gt;trực tiếp giữa hai thực thể&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;Bộ ba (S, P, O)&lt;br&gt;&lt;br&gt;&lt;b&gt;Vai trò&lt;/b&gt;&lt;br&gt;Quan hệ trực tiếp&lt;br&gt;giữa hai thực thể"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;align=center;verticalAlign=top;spacingTop=10;"
                vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="280" height="280" as="geometry"/>
        </mxCell>

        <!-- ③ Path -->
        <mxCell id="path_lv" value="&lt;b style=&quot;font-size:18px&quot;&gt;③ Path&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Mô tả truy xuất&lt;/b&gt;&lt;br&gt;Duyệt đường dẫn 1–3 bước&lt;br&gt;qua các nút trung gian&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;Chuỗi 1–3 bước&lt;br&gt;&lt;br&gt;&lt;b&gt;Vai trò&lt;/b&gt;&lt;br&gt;Suy luận đa bước&lt;br&gt;qua nút trung gian"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;align=center;verticalAlign=top;spacingTop=10;"
                vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="280" height="280" as="geometry"/>
        </mxCell>

        <!-- ④ Subgraph -->
        <mxCell id="subgraph_lv" value="&lt;b style=&quot;font-size:18px&quot;&gt;④ Subgraph&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Mô tả truy xuất&lt;/b&gt;&lt;br&gt;Mở rộng vùng lân cận 1–2 bước&lt;br&gt;với cấu trúc quan hệ đầy đủ&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;Vùng lân cận 2 bước&lt;br&gt;&lt;br&gt;&lt;b&gt;Vai trò&lt;/b&gt;&lt;br&gt;Tổng hợp cấu trúc&lt;br&gt;xung quanh thực thể"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;align=center;verticalAlign=top;spacingTop=10;"
                vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="280" height="280" as="geometry"/>
        </mxCell>

        <!-- ĐẦU RA: GraphData G -->
        <mxCell id="output_g" value="&lt;b style=&quot;font-size:17px&quot;&gt;Đầu ra: GraphData G&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;nodes&lt;/b&gt; — danh sách nút (kèm thuộc tính)&lt;br&gt;• &lt;b&gt;triplets&lt;/b&gt; — danh sách bộ ba (chủ thể, quan hệ, đối tượng)&lt;br&gt;• &lt;b&gt;paths&lt;/b&gt; — danh sách đường dẫn (chuỗi 1–3 bước)&lt;br&gt;• &lt;b&gt;subgraph&lt;/b&gt; — vùng lân cận (nút + quan hệ)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;"
                vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="280" height="220" as="geometry"/>
        </mxCell>

        <!-- ARROWS Đầu vào → 4 mức -->
        <mxCell id="e_in_node" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
                edge="1" source="input" target="node_lv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_in_triplet" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
                edge="1" source="input" target="triplet_lv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_in_path" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
                edge="1" source="input" target="path_lv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_in_subgraph" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
                edge="1" source="input" target="subgraph_lv" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="160"/>
              <mxPoint x="540" y="160"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4 mức → Đầu ra G -->
        <mxCell id="e_node_out" value="nodes" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
                edge="1" source="node_lv" target="output_g" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_triplet_out" value="triplets" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;"
                edge="1" source="triplet_lv" target="output_g" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_path_out" value="paths" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;"
                edge="1" source="path_lv" target="output_g" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="340"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_subgraph_out" value="subgraph" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;"
                edge="1" source="subgraph_lv" target="output_g" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CHÚ THÍCH -->
        <mxCell id="legend" value="&lt;b&gt;Chú thích:&lt;/b&gt;&amp;nbsp;&amp;nbsp;Mỗi mức truy xuất tạo ra một loại dữ liệu khác nhau, được hợp nhất vào đối tượng &lt;b&gt;G&lt;/b&gt;. Tuỳ loại truy vấn (Local/Community/Global), chỉ tập con các mức được kích hoạt."
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;"
                vertex="1" parent="1">
          <mxGeometry x="80" y="850" width="1000" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
