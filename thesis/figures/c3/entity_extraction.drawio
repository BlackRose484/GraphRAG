<mxfile host="app.diagrams.net" agent="Claude" version="22.0.0" type="device">
  <diagram name="Entity Extraction" id="entity_extraction">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ĐẦU VÀO -->
        <mxCell id="input_q" value="&lt;b style=&quot;font-size:17px&quot;&gt;Đầu vào: q&lt;/b&gt;&lt;br&gt;&lt;br&gt;``Ai đóng vai Thị Màu&lt;br&gt;trong vở Quan Âm Thị Kính?''"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- BƯỚC 1: LÀM GIÀU TRUY VẤN (song song) -->
        <mxCell id="step1_panel" value="Bước 1 — Làm giàu truy vấn (song song)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;fontStyle=1;verticalAlign=top;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="640" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="branch_a" value="&lt;b style=&quot;font-size:15px&quot;&gt;Luồng A — Mở rộng truy vấn&lt;/b&gt;&lt;br&gt;&lt;br&gt;LLM bổ sung thuật ngữ và&lt;br&gt;ngữ cảnh nghệ thuật Chèo cho q&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra:&lt;/b&gt; truy vấn mở rộng q'"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="350" y="120" width="290" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="branch_b" value="&lt;b style=&quot;font-size:15px&quot;&gt;Luồng B — Phân rã truy vấn&lt;/b&gt;&lt;br&gt;&lt;br&gt;LLM phân rã q thành tập&lt;br&gt;câu hỏi con đa bước&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra:&lt;/b&gt; {q₁, q₂, …, qₙ}"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="650" y="120" width="290" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="latency_note" value="&lt;i&gt;Độ trễ tổng = max(t_A, t_B), không phải t_A + t_B&lt;/i&gt;"
                style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666;"
                vertex="1" parent="1">
          <mxGeometry x="350" y="270" width="590" height="40" as="geometry"/>
        </mxCell>

        <!-- ĐẦU RA TRUNG GIAN: Q -->
        <mxCell id="output_q" value="&lt;b style=&quot;font-size:17px&quot;&gt;Q&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q = (q, q', {q₁, …, qₙ})"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="1020" y="200" width="240" height="100" as="geometry"/>
        </mxCell>

        <!-- BƯỚC 2: TRÍCH XUẤT THỰC THỂ -->
        <mxCell id="step2_panel" value="Bước 2 — Trích xuất thực thể (tuần tự)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontStyle=1;verticalAlign=top;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="320" y="450" width="640" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="step2_input" value="&lt;b&gt;Đầu vào:&lt;/b&gt;&lt;br&gt;Tập truy vấn đã làm giàu&lt;br&gt;{q, q', q₁, …, qₙ}&lt;br&gt;+ Danh mục thực thể"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="350" y="510" width="290" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="step2_action" value="&lt;b&gt;Thao tác:&lt;/b&gt;&lt;br&gt;&lt;br&gt;LLM trích xuất các thực thể&lt;br&gt;&lt;b&gt;chỉ&lt;/b&gt; chọn từ Danh mục thực thể&lt;br&gt;&lt;br&gt;Phân loại theo nhóm:&lt;br&gt;characters, actors, plays, scenes"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="650" y="510" width="290" height="160" as="geometry"/>
        </mxCell>

        <!-- DANH MỤC THỰC THỂ (cylinder, ngoài) -->
        <mxCell id="entity_catalog" value="&lt;b&gt;Danh mục thực thể&lt;/b&gt;&lt;br&gt;&lt;br&gt;(nạp từ Knowledge Graph&lt;br&gt;khi khởi tạo hệ thống)"
                style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="220" height="160" as="geometry"/>
        </mxCell>

        <!-- ĐẦU RA: E -->
        <mxCell id="output_e" value="&lt;b style=&quot;font-size:17px&quot;&gt;Đầu ra: E&lt;/b&gt;&lt;br&gt;&lt;br&gt;characters: [Thị Màu]&lt;br&gt;plays: [Quan Âm Thị Kính]&lt;br&gt;actors: [ ]&lt;br&gt;scenes: [ ]"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="1020" y="540" width="240" height="160" as="geometry"/>
        </mxCell>

        <!-- ARROWS -->
        <!-- q → Bước 1 -->
        <mxCell id="e_q_s1" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2.5;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
                edge="1" source="input_q" target="step1_panel" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Bước 1 → Q -->
        <mxCell id="e_s1_q" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2.5;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
                edge="1" source="step1_panel" target="output_q" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Bước 1 → Bước 2 -->
        <mxCell id="e_s1_s2" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2.5;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
                edge="1" source="step1_panel" target="step2_panel" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Catalog → Bước 2 -->
        <mxCell id="e_cat_s2" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
                edge="1" source="entity_catalog" target="step2_input" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Bước 2 → E -->
        <mxCell id="e_s2_e" style="endArrow=classic;html=1;rounded=0;strokeColor=#555555;strokeWidth=2.5;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
                edge="1" source="step2_action" target="output_e" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
