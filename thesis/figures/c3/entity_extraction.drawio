<mxfile host="app.diagrams.net" agent="Claude" version="22.0.0" type="device">
  <diagram name="Entity Extraction" id="entity_extraction">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ĐẦU VÀO -->
        <mxCell id="input_q" value="&lt;b style=&quot;font-size:17px&quot;&gt;Đầu vào: q&lt;/b&gt;&lt;br&gt;&lt;br&gt;``Ai đóng vai Thị Màu&lt;br&gt;trong vở Quan Âm Thị Kính?''"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- DANH MỤC THỰC THỂ -->
        <mxCell id="entity_catalog" value="&lt;b&gt;Danh mục thực thể&lt;/b&gt;&lt;br&gt;&lt;br&gt;(nạp từ đồ thị tri thức&lt;br&gt;khi khởi tạo hệ thống)&lt;br&gt;&lt;br&gt;&lt;i&gt;Tiêm vào prompt&lt;/i&gt;&lt;br&gt;&lt;i&gt;của cả Tiến trình A và B&lt;/i&gt;"
                style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="220" height="180" as="geometry"/>
        </mxCell>

        <!-- PANEL: Hai tiến trình LLM song song -->
        <mxCell id="step_panel" value="Hai tiến trình LLM song song"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;fontStyle=1;verticalAlign=top;align=center;"
                vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="720" height="500" as="geometry"/>
        </mxCell>

        <!-- Tiến trình A -->
        <mxCell id="task_a" value="&lt;b style=&quot;font-size:16px&quot;&gt;Tiến trình A&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mở rộng + Trích xuất + Phân loại&lt;/b&gt;&lt;br&gt;&lt;br&gt;Một lượt gọi LLM thực hiện:&lt;br&gt;• Mở rộng q → q'&lt;br&gt;• Trích xuất thực thể&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(chỉ chọn từ Danh mục)&lt;br&gt;• Phân loại: Local / Community / Global&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra (JSON):&lt;/b&gt;&lt;br&gt;{ expanded: q',&lt;br&gt;&amp;nbsp;&amp;nbsp;entities: {…},&lt;br&gt;&amp;nbsp;&amp;nbsp;query_type: t }"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="350" y="120" width="320" height="320" as="geometry"/>
        </mxCell>

        <!-- Tiến trình B -->
        <mxCell id="task_b" value="&lt;b style=&quot;font-size:16px&quot;&gt;Tiến trình B&lt;/b&gt;&lt;br&gt;&lt;b&gt;Phân rã + Trích xuất bổ sung&lt;/b&gt;&lt;br&gt;&lt;br&gt;Một lượt gọi LLM thực hiện:&lt;br&gt;• Phân rã q thành các&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;câu hỏi con đơn lẻ&lt;br&gt;• Trích xuất thực thể trên&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;từng câu hỏi con&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(chỉ chọn từ Danh mục)&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu ra (JSON):&lt;/b&gt;&lt;br&gt;{ decomposed: [q₁, …, qₙ],&lt;br&gt;&amp;nbsp;&amp;nbsp;entities (E_B): {…} }&lt;br&gt;&lt;br&gt;&lt;i&gt;Vai trò: tăng recall&lt;/i&gt;&lt;br&gt;&lt;i&gt;cho câu hỏi đa khía cạnh&lt;/i&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="690" y="120" width="320" height="320" as="geometry"/>
        </mxCell>

        <!-- Latency note -->
        <mxCell id="latency_note" value="&lt;i&gt;Độ trễ tổng = max(t_A, t_B), không phải t_A + t_B&lt;/i&gt;"
                style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=2;fontColor=#666666;"
                vertex="1" parent="1">
          <mxGeometry x="350" y="490" width="660" height="40" as="geometry"/>
        </mxCell>

        <!-- ĐẦU RA: Q (ProcessedQuery) -->
        <mxCell id="output_q" value="&lt;b style=&quot;font-size:16px&quot;&gt;Q (ProcessedQuery)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q = (q, q', {q₁, …, qₙ})&lt;br&gt;&lt;br&gt;&lt;i&gt;Hiển thị ở giao diện&lt;/i&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="260" height="180" as="geometry"/>
        </mxCell>

        <!-- ĐẦU RA: E (hợp nhất E_A ∪ E_B) -->
        <mxCell id="output_e" value="&lt;b style=&quot;font-size:16px&quot;&gt;Đầu ra: E = E_A ∪ E_B&lt;/b&gt;&lt;br&gt;&lt;br&gt;characters: [Thị Màu]&lt;br&gt;plays: [Quan Âm Thị Kính]&lt;br&gt;actors: [ ]&lt;br&gt;scenes: [ ]&lt;br&gt;&lt;br&gt;&lt;i&gt;Hợp nhất (dedup):&lt;/i&gt;&lt;br&gt;&lt;i&gt;A precision + B recall&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Đầu vào cho truy xuất đồ thị&lt;/i&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="1100" y="320" width="260" height="200" as="geometry"/>
        </mxCell>

        <!-- ĐẦU RA: t (query_type) — tín hiệu định tuyến -->
        <mxCell id="output_t" value="&lt;b style=&quot;font-size:16px&quot;&gt;Đầu ra: t (query_type)&lt;/b&gt;&lt;br&gt;&lt;br&gt;t = ``Local''&lt;br&gt;&lt;br&gt;&lt;i&gt;Tín hiệu định tuyến:&lt;/i&gt;&lt;br&gt;&lt;i&gt;chọn mức truy xuất&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ chiến lược tạo sinh&lt;/i&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="1100" y="540" width="260" height="160" as="geometry"/>
        </mxCell>

        <!-- ARROWS -->
        <!-- q → Panel -->
        <mxCell id="e_q_panel" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;strokeWidth=2.5;fontSize=15;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;"
                edge="1" source="input_q" target="step_panel" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Catalog → Tác vụ A (dashed inject) -->
        <mxCell id="e_cat_a" value="inject" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=15;fontStyle=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;"
                edge="1" source="entity_catalog" target="task_a" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Catalog → Tác vụ B (dashed inject) -->
        <mxCell id="e_cat_b" value="inject" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=15;fontStyle=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;"
                edge="1" source="entity_catalog" target="task_b" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tác vụ A → Q (expanded part) -->
        <mxCell id="e_a_q" value="q'" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
                edge="1" source="task_a" target="output_q" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tác vụ A → E (entities E_A — precision side of union) -->
        <mxCell id="e_a_e" value="E_A" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2.5;fontSize=15;fontStyle=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;"
                edge="1" source="task_a" target="output_e" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tác vụ B → Q (decomposed sub-queries — for UI/debug) -->
        <mxCell id="e_b_q" value="[q₁..qₙ]" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontStyle=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;"
                edge="1" source="task_b" target="output_q" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tác vụ B → E (entities E_B — recall side of union) -->
        <mxCell id="e_b_e" value="E_B" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2.5;fontSize=15;fontStyle=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;"
                edge="1" source="task_b" target="output_e" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tác vụ A → t (query_type) -->
        <mxCell id="e_a_t" value="query_type" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;exitX=1;exitY=0.95;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
                edge="1" source="task_a" target="output_t" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
