<mxfile host="app.diagrams.net">
  <diagram name="KG-LLM Integration" id="kg_llm">
    <mxGraphModel dx="1600" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- INPUT from G-Retrieval -->
        <mxCell id="input_box" value="&lt;b&gt;Đầu vào từ G-Retrieval&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;strokeWidth=2;fontSize=15;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="260" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="in_c" value="&lt;b&gt;C&lt;/b&gt; = {(fᵢ, textᵢ)}&lt;br&gt;Tập ngữ cảnh đa định dạng&lt;br&gt;(đã chuyển đổi bởi&lt;br&gt;GraphFormatConverter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="in_k" value="&lt;b&gt;K&lt;/b&gt;&lt;br&gt;Dữ kiện chính&lt;br&gt;(bullet points)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="in_q" value="&lt;b&gt;q&lt;/b&gt;&lt;br&gt;Câu hỏi gốc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- _build_context: select & assemble -->
        <mxCell id="bc" value="&lt;b&gt;_build_context()&lt;/b&gt;&lt;br&gt;Chọn tập con formats&lt;br&gt;theo chiến lược hiện tại&lt;br&gt;Ghép K + C_subset → 𝒞" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=15;size=20;" vertex="1" parent="1">
          <mxGeometry x="350" y="135" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- Selected format sections -->
        <mxCell id="fmt_box" value="&lt;b&gt;Ngữ cảnh 𝒞 đã tổ hợp&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#333;strokeWidth=2;fontSize=15;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="30" width="500" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="s0" value="&lt;b&gt;① Context Header&lt;/b&gt;&lt;br&gt;&quot;Thông tin từ KG về Chèo&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="65" width="460" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;② Key Facts K&lt;/b&gt;&lt;br&gt;• Nhân vật: Thị Màu • Diễn viên: Vân Quyền ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="460" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;③ natural_language&lt;/b&gt;&lt;br&gt;&quot;Nhân vật Thị Màu trong vở QATK được đóng bởi Vân Quyền&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="180" width="460" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;③ adjacency_table / code_like&lt;/b&gt;&lt;br&gt;| Nguồn | Quan hệ | Đích | hoặc JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="240" width="460" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;③ ...định dạng khác&lt;/b&gt; (tùy strategy)&lt;br&gt;node_sequence / community_summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=15;fontColor=#999;" vertex="1" parent="1">
          <mxGeometry x="760" y="300" width="460" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="strat_note" value="Pre: NL + Table&lt;br&gt;Mid: NL + JSON&lt;br&gt;Post: NL + Table + JSON" style="text;html=1;fontSize=15;fontColor=#2e7d32;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="355" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- OUTPUT -->
        <mxCell id="output" value="→ 𝒞 cho&lt;br&gt;Prompt 𝒫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1290" y="170" width="170" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="strokeWidth=2.5;strokeColor=#333;" edge="1" source="input_box" target="bc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="strokeWidth=2.5;strokeColor=#333;" edge="1" source="bc" target="fmt_box" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="strokeWidth=2.5;strokeColor=#333;" edge="1" source="fmt_box" target="output" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Notes -->
        <mxCell id="note1" value="Inference-time context injection: LLM không fine-tune," style="text;html=1;fontSize=15;fontColor=#666;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="280" width="380" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="tri thức miền cung cấp hoàn toàn qua ngữ cảnh prompt" style="text;html=1;fontSize=15;fontColor=#666;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="310" width="380" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="note_src" value="← G-Retrieval (Tổ chức ngữ cảnh)" style="text;html=1;align=center;fontSize=15;fontColor=#999;" vertex="1" parent="1">
          <mxGeometry x="30" y="390" width="240" height="25" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
