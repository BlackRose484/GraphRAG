<mxfile host="app.diagrams.net">
  <diagram name="RAG-Overview" id="rag-overview-001">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ ONLINE QUERY PHASE FRAME ============ -->
        <mxCell id="frame-online" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=20;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" value="Pha truy vấn (online)" vertex="1">
          <mxGeometry height="280" width="1580" x="60" y="60" as="geometry" />
        </mxCell>

        <!-- q -->
        <mxCell id="q" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="&lt;b&gt;q&lt;/b&gt;&lt;br&gt;Câu hỏi" vertex="1">
          <mxGeometry height="100" width="160" x="100" y="160" as="geometry" />
        </mxCell>

        <!-- Encode -->
        <mxCell id="encode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="&lt;b&gt;Mã hoá câu hỏi&lt;/b&gt;&lt;br&gt;(embedding model)" vertex="1">
          <mxGeometry height="100" width="200" x="320" y="160" as="geometry" />
        </mxCell>

        <!-- Top-k search -->
        <mxCell id="topk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="&lt;b&gt;Tìm top-k&lt;/b&gt;&lt;br&gt;tương đồng véc-tơ" vertex="1">
          <mxGeometry height="100" width="200" x="600" y="160" as="geometry" />
        </mxCell>

        <!-- Prompt assembly -->
        <mxCell id="prompt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="&lt;b&gt;Lắp prompt&lt;/b&gt;&lt;br&gt;(q + k đoạn văn)" vertex="1">
          <mxGeometry height="100" width="200" x="880" y="160" as="geometry" />
        </mxCell>

        <!-- LLM -->
        <mxCell id="llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="LLM" vertex="1">
          <mxGeometry height="100" width="140" x="1160" y="160" as="geometry" />
        </mxCell>

        <!-- a -->
        <mxCell id="a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="&lt;b&gt;a&lt;/b&gt;&lt;br&gt;Câu trả lời" vertex="1">
          <mxGeometry height="100" width="160" x="1380" y="160" as="geometry" />
        </mxCell>

        <!-- Online arrows -->
        <mxCell id="ar1" edge="1" parent="1" source="q" target="encode" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=2.5;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
