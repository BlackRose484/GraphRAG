        <mxCell id="ar2" edge="1" parent="1" source="encode" target="topk" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=2.5;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="véc-tơ truy vấn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar3" edge="1" parent="1" source="topk" target="prompt" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=2.5;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="k đoạn văn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar4" edge="1" parent="1" source="prompt" target="llm" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=2.5;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="P">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar5" edge="1" parent="1" source="llm" target="a" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=2.5;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ DATA LAYER (Vector Store) ============ -->
        <mxCell id="vstore" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="&lt;b&gt;Vector Store&lt;/b&gt;&lt;br&gt;(đoạn văn + véc-tơ)" vertex="1">
          <mxGeometry height="180" width="220" x="590" y="430" as="geometry" />
        </mxCell>

        <!-- Vector Store ↔ topk -->
        <mxCell id="vs1" edge="1" parent="1" source="topk" target="vstore" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=14;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" value="truy vấn véc-tơ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vs2" edge="1" parent="1" source="vstore" target="topk" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=14;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" value="k đoạn tương đồng">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ OFFLINE INDEXING PHASE FRAME ============ -->
        <mxCell id="frame-offline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=20;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" value="Pha xây dựng chỉ mục (offline)" vertex="1">
          <mxGeometry height="200" width="1580" x="60" y="660" as="geometry" />
