        <!-- Documents -->
        <mxCell id="docs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="Tài liệu&lt;br&gt;văn bản" vertex="1">
          <mxGeometry height="90" width="160" x="160" y="715" as="geometry" />
        </mxCell>

        <!-- Chunking -->
        <mxCell id="chunk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="Chia đoạn&lt;br&gt;(chunking)" vertex="1">
          <mxGeometry height="90" width="160" x="380" y="715" as="geometry" />
        </mxCell>

        <!-- Embedding (offline) -->
        <mxCell id="emb-idx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;" value="Mô hình&lt;br&gt;embedding" vertex="1">
          <mxGeometry height="90" width="160" x="600" y="715" as="geometry" />
        </mxCell>

        <!-- Index arrows -->
        <mxCell id="ix1" edge="1" parent="1" source="docs" target="chunk" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=2.5;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ix2" edge="1" parent="1" source="chunk" target="emb-idx" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=2.5;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ix3" edge="1" parent="1" source="emb-idx" target="vstore" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2.5;fontSize=14;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="nạp vào">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;Chú thích.&lt;/b&gt; Mũi tên liền: dòng dữ liệu chính.&amp;nbsp; Mũi tên đứt (xanh): truy vấn / phản hồi từ Vector Store. q: câu hỏi gốc; P: prompt hoàn chỉnh; a: câu trả lời." vertex="1">
          <mxGeometry height="40" width="1580" x="60" y="380" as="geometry" />
