@prefix : <http://www.semanticweb.org/asus/ontologies/2025/5/Cheo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix Cheo: <http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/asus/ontologies/2025/5/Cheo/> .

<http://www.semanticweb.org/asus/ontologies/2025/5/Cheo> rdf:type owl:Ontology ;
                                                          rdfs:comment "Đây là Ontology về Chèo" .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#forCharacter
Cheo:forCharacter rdf:type owl:ObjectProperty ;
                  rdfs:domain Cheo:RoleAssignment ;
                  rdfs:range Cheo:Character ;
                  rdfs:comment "Vai diễn thể hiện (dành cho) nhân vật" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#hasAppearance
Cheo:hasAppearance rdf:type owl:ObjectProperty ;
                   rdfs:domain Cheo:RoleAssignment ;
                   rdfs:range Cheo:Appearance ;
                   rdfs:comment "Sự xuất hiện của một vai diễn trong một phiên bản của trích đoạn nào đó" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#hasCharacter
Cheo:hasCharacter rdf:type owl:ObjectProperty ;
                  rdfs:domain Cheo:Play ;
                  rdfs:range Cheo:Character ;
                  rdfs:comment "Vở chèo có các nhân vật" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#hasScene
Cheo:hasScene rdf:type owl:ObjectProperty ;
              rdfs:domain Cheo:Play ;
              rdfs:range Cheo:Scene ;
              rdfs:comment "Vở chèo có các cảnh" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#hasVersion
Cheo:hasVersion rdf:type owl:ObjectProperty ;
                rdfs:domain Cheo:Scene ;
                rdfs:range Cheo:Version ;
                rdfs:comment "Một trích đoạn chèo có thể có nhiều phiên bản, do các diễn viên khác nhau đóng" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#inVersion
Cheo:inVersion rdf:type owl:ObjectProperty ;
               rdfs:domain Cheo:RoleAssignment ;
               rdfs:range Cheo:Version ;
               rdfs:comment "Vai diễn thuộc phiên bản nào của trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#performedBy
Cheo:performedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain Cheo:RoleAssignment ;
                 rdfs:range Cheo:Actor ;
                 rdfs:comment "Vai diễn được trình bày bởi diễn viên" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#ED
Cheo:ED rdf:type owl:DatatypeProperty ;
        rdfs:domain Cheo:Appearance ;
        rdfs:comment "emotional development - Diễn biến tâm lý" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#ID
Cheo:ID rdf:type owl:DatatypeProperty ;
        rdfs:domain Cheo:Version ;
        rdfs:comment "Số định danh của mỗi phiên bản trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#actorGender
Cheo:actorGender rdf:type owl:DatatypeProperty ;
                 rdfs:domain Cheo:Actor ;
                 rdfs:comment "Giới tính của diễn viên" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#actorName
Cheo:actorName rdf:type owl:DatatypeProperty ;
               rdfs:domain Cheo:Actor ;
               rdfs:comment "Tên diễn viên" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#aspectRatio
Cheo:aspectRatio rdf:type owl:DatatypeProperty ;
                 rdfs:domain Cheo:Version ;
                 rdfs:comment "Tỉ lệ khung hình" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#author
Cheo:author rdf:type owl:DatatypeProperty ;
            rdfs:domain Cheo:Play ;
            rdfs:comment "Tác giả dựng vở chèo" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#charGender
Cheo:charGender rdf:type owl:DatatypeProperty ;
                rdfs:domain Cheo:Character ;
                rdfs:comment "Giới tính nhân vật" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#charName
Cheo:charName rdf:type owl:DatatypeProperty ;
              rdfs:domain Cheo:Character ;
              rdfs:comment "Tên nhân vật" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#description
Cheo:description rdf:type owl:DatatypeProperty ;
                 rdfs:domain Cheo:Character ;
                 rdfs:comment "Mô tả tính cách/ hoàn cảnh nhân vật" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#emotion
Cheo:emotion rdf:type owl:DatatypeProperty ;
             rdfs:domain Cheo:Appearance ;
             rdfs:range xsd:string ;
             rdfs:comment "Biểu cảm của nhân vật trong một lần xuất hiện" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#end
Cheo:end rdf:type owl:DatatypeProperty ;
         rdfs:domain Cheo:Appearance ;
         rdfs:range xsd:decimal ;
         rdfs:comment "Thời điểm kết thúc xuất hiện của nhân vật trong một lần xuất hiện" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#endTime
Cheo:endTime rdf:type owl:DatatypeProperty ;
             rdfs:domain Cheo:Version ;
             rdfs:comment "Thời gian kết thúc của một phiên bản trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#mainType
Cheo:mainType rdf:type owl:DatatypeProperty ;
              rdfs:domain Cheo:Character ;
              rdfs:comment "Kiểu nhân vật" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#resolution
Cheo:resolution rdf:type owl:DatatypeProperty ;
                rdfs:domain Cheo:Version ;
                rdfs:comment "Độ phân giải" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#sceneName
Cheo:sceneName rdf:type owl:DatatypeProperty ;
               rdfs:domain Cheo:Scene ;
               rdfs:comment "Tên của trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#sceneNumber
Cheo:sceneNumber rdf:type owl:DatatypeProperty ;
                 rdfs:domain Cheo:Play ;
                 rdfs:comment "Số lượng trích đoạn trong một vở chèo" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#sceneSummary
Cheo:sceneSummary rdf:type owl:DatatypeProperty ;
                  rdfs:domain Cheo:Scene ;
                  rdfs:comment "Tóm tắt nội dung của trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#showDate
Cheo:showDate rdf:type owl:DatatypeProperty ;
              rdfs:domain Cheo:Version ;
              rdfs:comment "Ngày diễn ra buổi biểu diễn (phiên bản của trích đoạn)" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#start
Cheo:start rdf:type owl:DatatypeProperty ;
           rdfs:domain Cheo:Appearance ;
           rdfs:range xsd:decimal ;
           rdfs:comment "Thời điểm bắt đầu xuất hiện của nhân vật trong một lần xuất hiện" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#startTime
Cheo:startTime rdf:type owl:DatatypeProperty ;
               rdfs:domain Cheo:Version ;
               rdfs:comment "Thời gian bắt đầu của một phiên bản trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#subType
Cheo:subType rdf:type owl:DatatypeProperty ;
             rdfs:domain Cheo:Character ;
             rdfs:comment "Kiểu phụ của nhân vật" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#subtitle
Cheo:subtitle rdf:type owl:DatatypeProperty ;
              rdfs:domain Cheo:Appearance ;
              rdfs:comment "Lời thoại" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#summary
Cheo:summary rdf:type owl:DatatypeProperty ;
             rdfs:domain Cheo:Play ;
             rdfs:range xsd:string ;
             rdfs:comment "Tóm tắt nội dung vở chèo" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#title
Cheo:title rdf:type owl:DatatypeProperty ;
           rdfs:domain Cheo:Play ;
           rdfs:comment "Tên vở chèo" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#versionNumber
Cheo:versionNumber rdf:type owl:DatatypeProperty ;
                   rdfs:domain Cheo:Scene ;
                   rdfs:comment "số các phiên bản của 1 trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#vidVersion
Cheo:vidVersion rdf:type owl:DatatypeProperty ;
                rdfs:domain Cheo:Version ;
                rdfs:comment "Link video các version của một trích đoạn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#videoDuration
Cheo:videoDuration rdf:type owl:DatatypeProperty ;
                   rdfs:domain Cheo:Version ;
                   rdfs:comment "Độ dài vở chèo" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#Actor
Cheo:Actor rdf:type owl:Class ;
           rdfs:comment "Diễn viên đảm nhận vai diễn" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#Appearance
Cheo:Appearance rdf:type owl:Class ;
                rdfs:comment "(class trung gian) Mô tả lần xuất hiện cụ thể của một nhân vật trong một phiên bản của trích đoạn nào đó, chứa thông tin thời gian và cảm xúc" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#Character
Cheo:Character rdf:type owl:Class ;
               rdfs:comment "Nhân vật xuất hiện trong vở chèo" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#Play
Cheo:Play rdf:type owl:Class ;
          rdfs:comment "Vở chèo" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#RoleAssignment
Cheo:RoleAssignment rdf:type owl:Class ;
                    rdfs:comment """(class trung gian) 
- Mô tả một vai diễn sẽ thuộc phiên bản nào của trích đoạn nào
- Do diễn viên nào thể hiện
- Thể hiện nhân vật gì
- Số lần xuất hiện của nhân vật xuyên suốt buổi biểu diễn""" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#Scene
Cheo:Scene rdf:type owl:Class ;
           rdfs:comment "Một trích đoạn (cảnh) cụ thể trong vở chèo" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#Version
Cheo:Version rdf:type owl:Class ;
             rdfs:comment "Phiên bản của trích đoạn" .


