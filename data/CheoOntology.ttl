                                                                                 Cheo:Character ;
                                                                        Cheo:charGender "Nam" ;
                                                                        Cheo:charName "Hề (Lớp \"Tiên Nữ - Đoàn tụ)" ;
                                                                        Cheo:description "Nhân vật phụ mang màu sắc hài hước, đồng thời là cầu nối cho biến cố đoàn tụ. Chính nhờ mời hai mẹ con phó xẩm về hát cho quan nghe để bớt u sầu, mà Trương Viên mới có cơ duyên nhận lại vợ hiền và mẹ già." ;
                                                                        Cheo:mainType "Hề" ;
                                                                        Cheo:subType "Áo ngắn" .


