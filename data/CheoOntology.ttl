###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#char_Khoeo
Cheo:char_Khoeo rdf:type owl:NamedIndividual ,
                         Cheo:Character ;
                Cheo:charGender "Nam" ;
                Cheo:charName "Khoèo" ;
