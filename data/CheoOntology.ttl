###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#char_ChauLong
Cheo:char_ChauLong rdf:type owl:NamedIndividual ,
                            Cheo:Character ;
                   Cheo:charGender "Nữ" ;
                   Cheo:charName "Châu Long" ;
                   Cheo:description "Vợ ba của Dương Lễ. Nàng giàu lòng vị tha, chấp nhận rời chồng để âm thầm nuôi dưỡng bạn của chồng ăn học. Trong ba năm, nàng tận tụy lo toan, giữ trọn tiết hạnh, là biểu tượng cho đức hy sinh, thủy chung và nhân nghĩa." ;
                   Cheo:mainType "Đào" ;
                   Cheo:subType "Chín" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#char_DaoHue
Cheo:char_DaoHue rdf:type owl:NamedIndividual ,
                          Cheo:Character ;
                 Cheo:charGender "Nữ" ;
                 Cheo:charName "Đào Huế" ;
                 Cheo:description "Là người con gái xứ Huế, vợ của quan Tuần Ty, trong một lần ra Bắc tìm chồng đã bắt gặp cảnh chồng gian díu với tình nhân. Và một trận “cuồng phong” dữ dội của sự ghen tuông đã nổi lên trong lòng cô Đào xứ Huế." ;
                 Cheo:mainType "Đào" ;
                 Cheo:subType "Chín" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#char_DuongLe
Cheo:char_DuongLe rdf:type owl:NamedIndividual ,
                           Cheo:Character ;
                  Cheo:charGender "Nam" ;
                  Cheo:charName "Dương Lễ" ;
                  Cheo:description "Người con xứ Sơn Tây, ham học, đỗ Trạng nguyên và ra làm quan. Tuy ngoài mặt lạnh lùng, thậm chí tỏ ra hắt hủi bạn, nhưng thực tâm ông muốn thử chí khí Lưu Bình. Dương Lễ là người bạn nghĩa tình, dùng mưu kế để giúp bạn có cơ hội vươn lên." ;
                  Cheo:mainType "Kép" ;
                  Cheo:subType "Chín" .


###  http://www.semanticweb.org/asus/ontologies/2025/5/Cheo#char_HyDong
Cheo:char_HyDong rdf:type owl:NamedIndividual ,
                          Cheo:Character ;
                 Cheo:charGender "Nữ" ;
                 Cheo:charName "Hỷ đồng" ;
                 Cheo:description "..." ;
